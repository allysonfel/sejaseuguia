# Postgres (o schema e os dados iniciais de Lisboa são criados sozinhos na 1ª requisição)
DATABASE_URL=postgres://postgres:SENHA@localhost:5432/sejaseuguia

# Assina o cookie de sessão. Use uma string longa e aleatória.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Primeiro acesso da equipe: criado automaticamente se ainda não existir ninguém na equipe.
ADMIN_EMAIL=admin@sejaseuguia.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Nome da agência que aparece no app e no painel.
AGENCY_NAME=Lux Viagens e Turismo
AGENCY_SUPPORT_EMAIL=

# Endereço público do app (links de convite, recuperação de senha e roteiro compartilhado).
APP_URL=http://localhost:3100

# Opcional: envio de e-mail (recuperação de senha e convites) pela Resend.
# Sem isso, os links aparecem no log do servidor.
RESEND_API_KEY=
MAIL_FROM=

# IA do "O que é esse lugar?" (reconhece o lugar pela foto), tentadas na ordem de
# IA_PROVEDOR (Gemini pago primeiro); sem nenhuma chave, o app usa só a localização.
IA_PROVEDOR=gemini,glm,groq
# Z.ai, GLM-4.6V-Flash: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Groq, Qwen 3.8 27B (reserva, ~2 fotos/min no grátis): https://console.groq.com/keys
GROQ_API_KEY=

# Cobrança (planos por viagem e assinatura). Desligada (padrão): tudo liberado, como antes.
COBRANCA_ATIVA=0
# "cakto" (produção) ou "simulado" (só com APP_URL em localhost: tela /app/pagamento-simulado).
PAGAMENTOS_PROVEDOR=simulado
# Segredo devolvido pela Cakto ao cadastrar o webhook (URL: <APP_URL>/api/pagamentos/cakto).
CAKTO_WEBHOOK_SECRET=
# CNPJ da agência, mostrado na política de privacidade e nos termos.
AGENCY_CNPJ=
